<section class="home-hero py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-7 text-start">
                <h1 class="display-4 fw-bold">
                    あなたにぴったりの<br>
                    <span class="hero-highlight">面白い</span>がきっと見つかる
                </h1>

                    <p class="mb-4 text-muted">
                        好きなお笑いのジャンルや好みをもとに、
                        AIがおすすめの芸人を紹介します。<br>
                        みんなのおすすめから、新しい芸人との出会いも楽しめます。
                    </p>
                    <%= link_to "AIおすすめ", recommendations_path, class: "btn btn-lg btn-primary-custom" %>
                    <%= link_to "みんなのおすすめ", posts_path, class: "btn btn-lg btn-secondary-custom" %>
            </div>

            <div class="col-5 text-center">
                <%= image_tag "top_page_image.png", class: "img-fluid w-75" %>
            </div>
        </div>
    </div>
</section>
